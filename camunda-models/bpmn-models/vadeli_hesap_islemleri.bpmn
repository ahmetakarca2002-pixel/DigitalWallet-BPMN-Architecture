  <bpmn:process id="vadeliParaTransferi" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1" name="Hesap Oluşturma isteği geldi">
      <bpmn:outgoing>Flow_1r87yp0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_09301n7" name="Vadeli/Vadesiz Transfer Kısıtlamaları" camunda:resultVariable="depositTransferResult" camunda:decisionRef="hesapAcmaKisitlamalari" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="rejectionReason">${depositTransferResult.rejectionReason}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1r87yp0</bpmn:incoming>
      <bpmn:outgoing>Flow_1hjd8le</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_17s2uki">
      <bpmn:incoming>Flow_1hjd8le</bpmn:incoming>
      <bpmn:outgoing>Flow_031f888</bpmn:outgoing>
      <bpmn:outgoing>Flow_0c2ow8w</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1hjd8le" sourceRef="Activity_09301n7" targetRef="Gateway_17s2uki" />
    <bpmn:sequenceFlow id="Flow_1r87yp0" sourceRef="StartEvent_1" targetRef="Activity_09301n7" />
    <bpmn:serviceTask id="Activity_0jo8dtr" name="Bakiye ve AML Kontrolü" camunda:type="external" camunda:topic="check-balance-aml">
      <bpmn:incoming>Flow_031f888</bpmn:incoming>
      <bpmn:outgoing>Flow_0re181q</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_031f888" name="Evet" sourceRef="Gateway_17s2uki" targetRef="Activity_0jo8dtr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${depositTransferResult.isDepositTransferAllowed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0luoh4g" name="İade İşlemi" camunda:type="external" camunda:topic="transfer-timeout">
      <bpmn:incoming>Flow_0c2ow8w</bpmn:incoming>
      <bpmn:outgoing>Flow_1vv07kh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0c2ow8w" name="Hayır" sourceRef="Gateway_17s2uki" targetRef="Activity_0luoh4g">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${depositTransferResult.isDepositTransferAllowed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1dtecku" name="Zaman Aşımı İptali">
      <bpmn:incoming>Flow_1vv07kh</bpmn:incoming>
