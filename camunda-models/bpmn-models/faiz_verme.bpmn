          <camunda:inputOutput>
            <camunda:inputParameter name="customerType">${account.prop("customer_type").stringValue()}</camunda:inputParameter>
            <camunda:inputParameter name="amount">${account.prop("balance").numberValue() + account.prop("maturity_value").numberValue()}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0az8dp4</bpmn:incoming>
        <bpmn:outgoing>Flow_1dqxfk7</bpmn:outgoing>
