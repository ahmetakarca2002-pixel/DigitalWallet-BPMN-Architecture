      <bpmn:startEvent id="Event_15smh8z">
        <bpmn:outgoing>Flow_0az8dp4</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="Activity_0cka8xk" name="Yeni Faizi Belirle" camunda:resultVariable="depositRate" camunda:decisionRef="timeDepositRates" camunda:mapDecisionResult="singleEntry">
